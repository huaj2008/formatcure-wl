<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
           xsi:type="TaskPaneApp">

  <!-- Basic Add-in Information -->
  <Id>a1b2c3d4-e5f6-7890-abcd-ef1234567890</Id>
  <Version>1.5.0</Version>
  <ProviderName>FormatCure WL</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="FormatCure WL"/>
  <Description DefaultValue="Professional document formatting for regulatory submissions, SOPs, and quality documents."/>
  <IconUrl DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://github.com/huaj2008/docualign-test"/>

  <!-- Hosts -->
  <Hosts>
    <Host Name="Document"/>
  </Hosts>

  <!-- Requirements -->
  <Requirements>
    <Sets>
      <Set Name="WordApi" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <!-- Default Settings -->
  <DefaultSettings>
    <SourceLocation DefaultValue="https://huaj2008.github.io/formatcure-wl/taskpane.html"/>
  </DefaultSettings>

  <!-- Permissions -->
  <Permissions>ReadWriteDocument</Permissions>

  <!-- Version Overrides for Ribbon -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          
          <!-- Function File for Ribbon Commands -->
          <FunctionFile resid="Functions.Url"/>

          <!-- Ribbon Extension Point -->
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <CustomTab id="FormatCureTab">
              
              <!-- Group 1: Case Conversion -->
              <Group id="CaseGroup">
                <Label resid="CaseGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                
                <Control xsi:type="Button" id="TitleCaseBtn">
                  <Label resid="TitleCase.Label"/>
                  <Supertip>
                    <Title resid="TitleCase.Label"/>
                    <Description resid="TitleCase.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="TitleCase.16"/>
                    <bt:Image size="32" resid="TitleCase.32"/>
                    <bt:Image size="80" resid="TitleCase.80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>applyTitleCase</FunctionName>
                  </Action>
                </Control>

                <Control xsi:type="Button" id="SentenceCaseBtn">
                  <Label resid="SentenceCase.Label"/>
                  <Supertip>
                    <Title resid="SentenceCase.Label"/>
                    <Description resid="SentenceCase.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="SentenceCase.16"/>
                    <bt:Image size="32" resid="SentenceCase.32"/>
                    <bt:Image size="80" resid="SentenceCase.80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>applySentenceCase</FunctionName>
                  </Action>
                </Control>
              </Group>

              <!-- Group 2: Formatting -->
              <Group id="FormatGroup">
                <Label resid="FormatGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>

                <Control xsi:type="Button" id="BodyFormatBtn">
                  <Label resid="BodyFormat.Label"/>
                  <Supertip>
                    <Title resid="BodyFormat.Label"/>
                    <Description resid="BodyFormat.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="BodyFormat.16"/>
                    <bt:Image size="32" resid="BodyFormat.32"/>
                    <bt:Image size="80" resid="BodyFormat.80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>applyBodyFormat</FunctionName>
                  </Action>
                </Control>

                <Control xsi:type="Button" id="CrossRefBtn">
                  <Label resid="CrossRef.Label"/>
                  <Supertip>
                    <Title resid="CrossRef.Label"/>
                    <Description resid="CrossRef.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="CrossRef.16"/>
                    <bt:Image size="32" resid="CrossRef.32"/>
                    <bt:Image size="80" resid="CrossRef.80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>applyCrossRefStyle</FunctionName>
                  </Action>
                </Control>

                <Control xsi:type="Button" id="EctdLinkBtn">
                  <Label resid="EctdLink.Label"/>
                  <Supertip>
                    <Title resid="EctdLink.Label"/>
                    <Description resid="EctdLink.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="EctdLink.16"/>
                    <bt:Image size="32" resid="EctdLink.32"/>
                    <bt:Image size="80" resid="EctdLink.80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>applyEctdLinkStyle</FunctionName>
                  </Action>
                </Control>

                <Control xsi:type="Button" id="LatinTermsBtn">
                  <Label resid="LatinTerms.Label"/>
                  <Supertip>
                    <Title resid="LatinTerms.Label"/>
                    <Description resid="LatinTerms.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="LatinTerms.16"/>
                    <bt:Image size="32" resid="LatinTerms.32"/>
                    <bt:Image size="80" resid="LatinTerms.80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>applyLatinTerms</FunctionName>
                  </Action>
                </Control>
              </Group>

              <!-- Group 3: More Options -->
              <Group id="MoreGroup">
                <Label resid="MoreGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>

                <Control xsi:type="Button" id="TaskpaneBtn">
                  <Label resid="Taskpane.Label"/>
                  <Supertip>
                    <Title resid="Taskpane.Label"/>
                    <Description resid="Taskpane.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="More.16"/>
                    <bt:Image size="32" resid="More.32"/>
                    <bt:Image size="80" resid="More.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>FormatCureTaskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>

              <Label resid="Tab.Label"/>
            </CustomTab>
          </ExtensionPoint>

        </DesktopFormFactor>
      </Host>
    </Hosts>

    <!-- Resources -->
    <Resources>
      <bt:Images>
        <!-- Default icons -->
        <bt:Image id="Icon.16x16" DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/icon-80.png"/>
        <!-- Title Case icons -->
        <bt:Image id="TitleCase.16" DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/title-case-16.png"/>
        <bt:Image id="TitleCase.32" DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/title-case-32.png"/>
        <bt:Image id="TitleCase.80" DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/title-case-80.png"/>
        <!-- Sentence Case icons -->
        <bt:Image id="SentenceCase.16" DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/sentence-case-16.png"/>
        <bt:Image id="SentenceCase.32" DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/sentence-case-32.png"/>
        <bt:Image id="SentenceCase.80" DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/sentence-case-80.png"/>
        <!-- Body Format icons -->
        <bt:Image id="BodyFormat.16" DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/body-format-16.png"/>
        <bt:Image id="BodyFormat.32" DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/body-format-32.png"/>
        <bt:Image id="BodyFormat.80" DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/body-format-80.png"/>
        <!-- Cross-Ref icons -->
        <bt:Image id="CrossRef.16" DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/cross-ref-16.png"/>
        <bt:Image id="CrossRef.32" DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/cross-ref-32.png"/>
        <bt:Image id="CrossRef.80" DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/cross-ref-80.png"/>
        <!-- eCTD Link icons -->
        <bt:Image id="EctdLink.16" DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/ectd-link-16.png"/>
        <bt:Image id="EctdLink.32" DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/ectd-link-32.png"/>
        <bt:Image id="EctdLink.80" DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/ectd-link-80.png"/>
        <!-- Latin Terms icons -->
        <bt:Image id="LatinTerms.16" DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/latin-terms-16.png"/>
        <bt:Image id="LatinTerms.32" DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/latin-terms-32.png"/>
        <bt:Image id="LatinTerms.80" DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/latin-terms-80.png"/>
        <!-- More Options icons -->
        <bt:Image id="More.16" DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/more-16.png"/>
        <bt:Image id="More.32" DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/more-32.png"/>
        <bt:Image id="More.80" DefaultValue="https://huaj2008.github.io/formatcure-wl/assets/more-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Functions.Url" DefaultValue="https://huaj2008.github.io/formatcure-wl/functions.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://huaj2008.github.io/formatcure-wl/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Tab.Label" DefaultValue="FormatCure WL"/>
        <bt:String id="CaseGroup.Label" DefaultValue="Case"/>
        <bt:String id="FormatGroup.Label" DefaultValue="Format"/>
        <bt:String id="MoreGroup.Label" DefaultValue="More"/>
        <bt:String id="TitleCase.Label" DefaultValue="Title Case"/>
        <bt:String id="SentenceCase.Label" DefaultValue="Sentence Case"/>
        <bt:String id="BodyFormat.Label" DefaultValue="Body Format"/>
        <bt:String id="CrossRef.Label" DefaultValue="Cross-Ref"/>
        <bt:String id="EctdLink.Label" DefaultValue="eCTD Link"/>
        <bt:String id="LatinTerms.Label" DefaultValue="Latin Terms"/>
        <bt:String id="Taskpane.Label" DefaultValue="All Tools"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TitleCase.Tooltip" DefaultValue="Convert to Title Case. Preserves pharma acronyms."/>
        <bt:String id="SentenceCase.Tooltip" DefaultValue="Convert to Sentence Case. Preserves pharma acronyms."/>
        <bt:String id="BodyFormat.Tooltip" DefaultValue="Apply body format: Sentence Case, TNR 12pt, 1.15 spacing."/>
        <bt:String id="CrossRef.Tooltip" DefaultValue="Format as cross-reference: Blue, Bold, Underlined."/>
        <bt:String id="EctdLink.Tooltip" DefaultValue="Format as eCTD link: Blue, Underlined, NOT bold."/>
        <bt:String id="LatinTerms.Tooltip" DefaultValue="Auto-italicize Latin terms: in vivo, in vitro, etc."/>
        <bt:String id="Taskpane.Tooltip" DefaultValue="Open full FormatCure WL panel with all formatting tools."/>
      </bt:LongStrings>
    </Resources>

  </VersionOverrides>
</OfficeApp>
